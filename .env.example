# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME"

# Auth.js canonical production origin (set to the exact deployed HTTPS origin in Netlify Production).
# Local development can use http://localhost:3000.
AUTH_URL=http://localhost:3000

# Auth.js server secret. Generate with:
# npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth credentials. Never expose these as NEXT_PUBLIC_* variables.
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Media storage. Local filesystem is development-safe only; use a persistent object-storage adapter before production uploads.
# Optional: absolute local directory for managed media files.
MEDIA_STORAGE_DIR=""

# Optional local-only admin bootstrap. This never creates a user.
# Set both values intentionally, then run: npm run auth:bootstrap-admin
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_CONFIRM=""

# Phase 8.15 secure preview/scheduler secrets (server-only)
PREVIEW_SECRET=
SCHEDULER_SECRET=

# Phase 8.17 payment provider configuration. Leave unset until a real provider is selected.
PAYMENT_PROVIDER=""

# Phase 8.18 transactional email (Resend REST provider)
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL=""
NOTIFICATION_FROM_NAME="Bittumama"
NOTIFICATION_REPLY_TO=""
NOTIFICATION_INTERNAL_EMAILS=""
