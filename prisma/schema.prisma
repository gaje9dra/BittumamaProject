generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ServiceAvailability {
  AVAILABLE
  COMING_SOON
}

enum ResearchAvailability {
  AVAILABLE
  COMING_SOON
}

enum EventRegistrationStatus {
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  COMING_SOON
  COMPLETED
}

enum EventFormat {
  ONLINE
  IN_PERSON
  HYBRID
}

enum EventRegistrationMode {
  ANONYMOUS_ALLOWED
  AUTHENTICATED_ONLY
}

enum EventRegistrationRecordStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
}

enum ContactInquiryStatus {
  NEW
  READ
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum UserRole {
  USER
  ADMIN
}

enum MediaStatus {
  ACTIVE
  ARCHIVED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentPurpose {
  SERVICE
  EVENT
  EVENT_REGISTRATION
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
}

enum AnalyticsEventCategory {
  PAGE
  CONTENT
  CONVERSION
}

enum AuditCategory {
  AUTHENTICATION
  AUTHORIZATION
  CONTENT
  MEDIA
  INQUIRY
  REGISTRATION
  PAYMENT
  NOTIFICATION
  SYSTEM
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditAction {
  AUTH_LOGIN
  AUTH_LOGOUT
  AUTH_LOGIN_FAILED
  USER_ROLE_CHANGED
  USER_SECURITY_CHANGED
  CONTENT_CREATED
  CONTENT_UPDATED
  CONTENT_PUBLISHED
  CONTENT_UNPUBLISHED
  CONTENT_ARCHIVED
  MEDIA_CREATED
  MEDIA_UPDATED
  MEDIA_DELETED
  INQUIRY_STATUS_CHANGED
  REGISTRATION_STATUS_CHANGED
  REGISTRATION_CANCELLED
  PAYMENT_RECONCILED
  PAYMENT_STATE_CHANGED
  NOTIFICATION_RETRIED
  SEARCH_ADMIN_ACTION
  SYSTEM_CONFIGURATION_CHANGED
}

enum AnalyticsEventName {
  PAGE_VIEW
  CONTENT_VIEW
  SERVICE_VIEW
  RESEARCH_VIEW
  EXPERT_VIEW
  ARTICLE_VIEW
  WORKSHOP_VIEW
  CONTACT_SUBMISSION
  REGISTRATION_STARTED
  REGISTRATION_COMPLETED
  PAYMENT_INITIATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  SEARCH_SUBMITTED
}

enum AnalyticsContentType {
  SERVICE
  RESEARCH
  EXPERT
  ARTICLE
  WORKSHOP
}

enum NotificationType {
  INQUIRY_RECEIVED
  REGISTRATION_RECEIVED
  REGISTRATION_CONFIRMED
  REGISTRATION_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_PENDING
}

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  name                String?
  email               String?            @unique
  emailVerified       DateTime?
  image               String?
  role                UserRole           @default(USER)
  passwordHash        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  accounts            Account[]
  sessions            Session[]
  contactInquiries    ContactInquiry[]
  eventRegistrations  EventRegistration[]
  paymentTransactions PaymentTransaction[]
  notifications       Notification[]
  analyticsEvents     AnalyticsEvent[]
  auditLogs           AuditLog[]

  @@index([role])
}

model AdminAccount {
  id              String         @id @default(cuid())
  email           String
  normalizedEmail String         @unique
  passwordHash    String
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lastLoginAt     DateTime?
  sessions        AdminSession[]

  @@index([isActive])
}

model AdminSession {
  id             String       @id @default(cuid())
  sessionToken   String       @unique
  adminAccountId String
  expires        DateTime
  createdAt      DateTime     @default(now())
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)

  @@index([adminAccountId])
  @@index([expires])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Service {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  category         String
  shortDescription String
  order            Int                 @default(0)
  need             String?
  focus            String?
  audience         String?
  highlights       Json?
  faq              Json?
  featured         Boolean             @default(false)
  availability     ServiceAvailability @default(AVAILABLE)
  status           ContentStatus       @default(PUBLISHED)
  publishAt        DateTime?
  seoTitle         String?
  seoDescription   String?
  seoImage         String?
  seoCanonical     String?
  seoNoIndex       Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  researchLinks    ResearchService[]
  articleLinks     ArticleService[]
  workshopLinks    WorkshopService[]
  expertLinks      ExpertService[]
  contactInquiries ContactInquiry[]
  paymentTransactions PaymentTransaction[]

  @@index([status])
  @@index([publishAt])
  @@index([category])
  @@index([order])
}

model ResearchItem {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  category         String
  shortDescription String
  order            Int                 @default(0)
  summary          String?
  date             DateTime?
  status           ContentStatus       @default(DRAFT)
  publishAt        DateTime?
  availability     ResearchAvailability @default(AVAILABLE)
  type             String?
  topic            String?
  image            String?
  imageMediaId     String?
  featured         Boolean             @default(false)
  tags             Json?
  highlights       Json?
  audience         Json?
  scope            Json?
  topics           Json?
  sections         Json?
  methodology      Json?
  seoTitle         String?
  seoDescription   String?
  seoImage         String?
  seoCanonical     String?
  seoNoIndex       Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  serviceLinks     ResearchService[]
  expertLinks      ExpertResearch[]
  articleLinks     ArticleResearch[]
  workshopLinks    WorkshopResearch[]
  imageMedia       MediaAsset?         @relation("ResearchImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([date])
  @@index([publishAt])
  @@index([order])
  @@index([imageMediaId])
}

model Expert {
  id                String           @id @default(cuid())
  slug              String           @unique
  name              String
  role              String?
  discipline        String?
  order             Int              @default(0)
  shortBio          String?
  bio               String?
  image             String?
  profileMediaId    String?
  expertise         Json?
  qualifications    Json?
  researchInterests Json?
  featured          Boolean          @default(false)
  status             ContentStatus    @default(PUBLISHED)
  publishAt         DateTime?
  seoTitle          String?
  seoDescription    String?
  seoImage          String?
  seoCanonical      String?
  seoNoIndex        Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  researchLinks     ExpertResearch[]
  serviceLinks      ExpertService[]
  authoredArticles  Article[]
  workshopEvents    Event[]
  articleLinks      ArticleExpert[]
  profileMedia      MediaAsset?      @relation("ExpertProfileMedia", fields: [profileMediaId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([discipline])
  @@index([publishAt])
  @@index([order])
  @@index([profileMediaId])
}

model ExpertService {
  expertId  String
  serviceId String
  expert    Expert  @relation(fields: [expertId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([expertId, serviceId])
  @@index([serviceId])
}

model Article {
  id             String            @id @default(cuid())
  slug           String            @unique
  title          String
  category       String
  order          Int               @default(0)
  date           DateTime?
  excerpt        String?
  author         String?
  authorRole     String?
  authorSlug     String?
  content        String?
  sections       Json?
  image          String?
  coverMediaId   String?
  featured       Boolean           @default(false)
  tags           Json?
  status         ContentStatus     @default(DRAFT)
  publishAt      DateTime?
  authorId       String?
  seoTitle       String?
  seoDescription String?
  seoImage       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  authorExpert   Expert?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  researchLinks  ArticleResearch[]
  serviceLinks   ArticleService[]
  relatedFrom    ArticleRelation[] @relation("ArticleRelationSource")
  relatedTo      ArticleRelation[] @relation("ArticleRelationTarget")
  expertLinks    ArticleExpert[]
  coverMedia     MediaAsset?       @relation("ArticleCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([date])
  @@index([order])
  @@index([publishAt])
  @@index([authorId])
  @@index([coverMediaId])
}

model Event {
  id                    String                   @id @default(cuid())
  slug                  String                   @unique
  title                 String
  order                 Int                      @default(0)
  date                  DateTime
  endDate               DateTime?
  time                  String?
  category              String
  location              String?
  format                EventFormat?
  shortDescription      String
  description           String?
  audience              Json?
  speakerId             String?
  speakerSlug           String?
  speakerRole           String?
  image                 String?
  coverMediaId          String?
  registrationLabel     String?
  registrationHref      String?
  registrationStatus    EventRegistrationStatus?
  registrationEnabled   Boolean                  @default(false)
  registrationCapacity  Int?
  registrationDeadline  DateTime?
  registrationMode      EventRegistrationMode    @default(ANONYMOUS_ALLOWED)
  featured              Boolean                  @default(false)
  status                ContentStatus            @default(DRAFT)
  publishAt             DateTime?
  seoTitle              String?
  seoDescription        String?
  seoImage              String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  speaker               Expert?                  @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  coverMedia            MediaAsset?              @relation("EventCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  researchLinks         WorkshopResearch[]
  serviceLinks          WorkshopService[]
  relatedFrom           EventRelation[]           @relation("EventRelationSource")
  relatedTo             EventRelation[]           @relation("EventRelationTarget")
  registrations         EventRegistration[]
  paymentTransactions   PaymentTransaction[]

  @@index([status])
  @@index([category])
  @@index([date])
  @@index([order])
  @@index([publishAt])
  @@index([speakerId])
  @@index([coverMediaId])
  @@index([registrationDeadline])
}

model ResearchService {
  researchId String
  serviceId  String
  research   ResearchItem @relation(fields: [researchId], references: [id], onDelete: Cascade)
  service    Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([researchId, serviceId])
  @@index([serviceId])
}

model ExpertResearch {
  expertId   String
  researchId String
  expert     Expert       @relation(fields: [expertId], references: [id], onDelete: Cascade)
  research   ResearchItem @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@id([expertId, researchId])
  @@index([researchId])
}

model ArticleResearch {
  articleId  String
  researchId String
  article    Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  research   ResearchItem @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@id([articleId, researchId])
  @@index([researchId])
}

model ArticleService {
  articleId String
  serviceId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([articleId, serviceId])
  @@index([serviceId])
}

model ArticleExpert {
  articleId String
  expertId  String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  expert    Expert  @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@id([articleId, expertId])
  @@index([expertId])
}

model ArticleRelation {
  sourceArticleId String
  targetArticleId String
  sourceArticle   Article @relation("ArticleRelationSource", fields: [sourceArticleId], references: [id], onDelete: Cascade)
  targetArticle   Article @relation("ArticleRelationTarget", fields: [targetArticleId], references: [id], onDelete: Cascade)

  @@id([sourceArticleId, targetArticleId])
  @@index([targetArticleId])
}

model WorkshopResearch {
  eventId    String
  researchId String
  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  research   ResearchItem @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@id([eventId, researchId])
  @@index([researchId])
}

model WorkshopService {
  eventId   String
  serviceId String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([eventId, serviceId])
  @@index([serviceId])
}

model EventRelation {
  sourceEventId String
  targetEventId String
  sourceEvent   Event @relation("EventRelationSource", fields: [sourceEventId], references: [id], onDelete: Cascade)
  targetEvent   Event @relation("EventRelationTarget", fields: [targetEventId], references: [id], onDelete: Cascade)

  @@id([sourceEventId, targetEventId])
  @@index([targetEventId])
}

model MediaAsset {
  id                 String      @id @default(cuid())
  storageKey         String      @unique
  publicUrl          String
  originalFilename   String
  normalizedFilename String
  mimeType           String
  fileSize           Int
  width              Int?
  height             Int?
  altText            String?
  caption            String?
  status              MediaStatus @default(ACTIVE)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  articleCovers      Article[]      @relation("ArticleCoverMedia")
  expertProfiles     Expert[]       @relation("ExpertProfileMedia")
  researchImages     ResearchItem[] @relation("ResearchImageMedia")
  eventCovers        Event[]        @relation("EventCoverMedia")

  @@index([createdAt])
  @@index([status])
  @@index([mimeType])
  @@index([originalFilename])
}

model ContactInquiry {
  id          String              @id @default(cuid())
  submittedAt DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  name        String
  email       String
  phone       String?
  serviceId   String?
  userId      String?
  message     String
  status      ContactInquiryStatus @default(NEW)
  service     Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedAt])
  @@index([serviceId])
  @@index([userId])
}

model EventRegistration {
  id                  String                         @id @default(cuid())
  eventId             String
  userId              String?
  fullName             String
  email               String
  phone                String?
  organization        String?
  notes               String?
  status              EventRegistrationRecordStatus @default(CONFIRMED)
  activeIdentityKey   String?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  event               Event                           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                User?                           @relation(fields: [userId], references: [id], onDelete: SetNull)
  paymentTransactions PaymentTransaction[]
  @@unique([eventId, activeIdentityKey])
  @@index([eventId, status])
  @@index([userId, createdAt])
  @@index([eventId, createdAt])
  @@index([email])
}

model PaymentTransaction {
  id                    String         @id @default(cuid())
  userId                String?
  eventId               String?
  registrationId         String?
  serviceId             String?
  reference             String         @unique
  idempotencyKey        String         @unique
  provider              String
  providerTransactionId String?
  amountMinor            Int
  currency              String
  purpose               PaymentPurpose
  status                PaymentStatus  @default(CREATED)
  description           String?
  metadata              Json?
  failureCode           String?
  failureMessage        String?
  paidAt                DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  user                  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  event                 Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  registration          EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  service               Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  @@unique([provider, providerTransactionId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([provider, createdAt])
  @@index([eventId])
  @@index([registrationId])
  @@index([serviceId])
  @@index([purpose, createdAt])
}

model Notification {
  id                 String               @id @default(cuid())
  userId             String?
  type               NotificationType
  channel            NotificationChannel
  status             NotificationStatus   @default(PENDING)
  subject            String?
  recipient          String
  relatedEntityType  String?
  relatedEntityId    String?
  payload            Json?
  provider           String?
  providerMessageId  String?
  dedupeKey          String               @unique
  scheduledFor       DateTime?
  sentAt             DateTime?
  failedAt           DateTime?
  failureCode        String?
  failureMessage     String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([status, scheduledFor])
  @@index([relatedEntityType, relatedEntityId])
  @@index([providerMessageId])
  @@index([type, status])
}

model AnalyticsEvent {
  id            String                 @id @default(cuid())
  eventName     AnalyticsEventName
  eventCategory AnalyticsEventCategory
  userId        String?
  anonymousId   String?
  sessionId     String?
  path          String?
  contentType   AnalyticsContentType?
  contentId     String?
  metadata      Json?
  occurredAt    DateTime               @default(now())
  createdAt     DateTime               @default(now())
  user          User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([occurredAt])
  @@index([eventName, occurredAt])
  @@index([eventCategory, occurredAt])
  @@index([contentType, contentId, occurredAt])
  @@index([userId, occurredAt])
  @@index([anonymousId, occurredAt])
}

model AuditLog {
  id          String        @id @default(cuid())
  actorUserId String? @db.Uuid
  action      AuditAction
  category    AuditCategory
  entityType  String?
  entityId    String?
  result      AuditResult
  severity    AuditSeverity @default(INFO)
  summary     String
  metadata    Json?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime      @default(now())
  actorUser   User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([category, createdAt])
  @@index([entityType, entityId])
  @@index([result, createdAt])
  @@index([severity, createdAt])
  @@index([requestId])
}
